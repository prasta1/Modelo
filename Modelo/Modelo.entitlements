<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Requesting a keychain access group forces Xcode's automatic signing to embed a
	Mac Team Provisioning Profile, which also grants com.apple.application-identifier.
	That identifier is what lets KeychainStore use the data-protection keychain
	(kSecUseDataProtectionKeychain); without it every SecItem call fails with
	errSecMissingEntitlement and secrets fall back to the legacy login keychain,
	whose signature-tied ACLs prompt for the keychain password after each reinstall.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
</dict>
</plist>
